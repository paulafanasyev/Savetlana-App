# =============================================================================
# Svetlana AI Commerce — environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
# The frontend NEVER receives any of these values. All AI provider calls are
# made server-side only.

# ---- Database ---------------------------------------------------------------
# Local development uses SQLite (works in constrained containers).
# Production target: PostgreSQL. Only this string needs to change.
DATABASE_URL="file:./dev.db"

# ---- Auth -------------------------------------------------------------------
# JWT signing secret for session tokens. Generate with: openssl rand -hex 32
JWT_SECRET="dev-only-secret-change-in-production-please"
JWT_EXPIRES_IN="7d"

# ---- AI Gateway -------------------------------------------------------------
# The external AI provider is referenced ONLY by these server-side variables.
# The brand the user sees is always "Светлана" regardless of these values.
# If AI_GATEWAY_API_KEY is empty, the gateway falls back to the deterministic
# rule-based MOCK/SAFBOX provider (clearly marked MOCK VERIFIED).
AI_GATEWAY_BASE_URL="https://api.example.com/v1"
AI_GATEWAY_API_KEY=""
AI_GATEWAY_MODEL="external-chat-model"
AI_GATEWAY_TIMEOUT_MS="30000"
AI_GATEWAY_MAX_RETRIES="2"

# Provider routing policy: comma-separated order of preference
AI_PROVIDER_ORDER="external,mock"

# Feature flags (1 = enabled, 0 = disabled)
FEATURE_AI_SEARCH="1"
FEATURE_PHOTO_SEARCH="1"
FEATURE_GIFT_AI="1"
FEATURE_VK_LOGIN="0"
FEATURE_ESIA_VERIFICATION="0"
FEATURE_SELLER_AI="1"
FEATURE_PRICE_ALERTS="1"
FEATURE_COLLECTIVE_GIFTS="1"
FEATURE_INTERNATIONAL_PAYMENTS="0"

# ---- Payments ---------------------------------------------------------------
# Payment partner adapter. Empty => sandbox/mock adapter (MOCK VERIFIED).
PAYMENT_PROVIDER_BASE_URL=""
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_MERCHANT_ID=""

# ---- Delivery ---------------------------------------------------------------
# Carrier adapters. Empty => sandbox/mock adapters (MOCK VERIFIED).
DELIVERY_PROVIDER_API_KEY=""

# CDEK — единственный перевозчик с реально реализованным API (v2: /orders, /selection).
# Заполните ЛИБО токен, ЛИБО пару account+secure key. Пусто => PENDING_EXTERNAL_ACCESS:
# платформа откажется создавать отправление вместо выдуманного трек-номера.
CDEK_TOKEN=""
CDEK_ACCOUNT=""
CDEK_SECURE_KEY=""
CARRIER_TIMEOUT_MS="15000"

# ---- Social / Identity adapters (PENDING_EXTERNAL_ACCESS when empty) --------
VK_APP_ID=""
VK_CLIENT_SECRET=""
ESIA_CLIENT_ID=""
ESIA_CLIENT_SECRET=""
ESIA_REDIRECT_URI=""

# ---- International payments (future) ---------------------------------------
ALIPAY_MERCHANT_ID=""
ALIPAY_PRIVATE_KEY=""

# ---- Platform configuration -------------------------------------------------
PLATFORM_FEE_PERCENT="1.5"
DEFAULT_CURRENCY="RUB"
NODE_ENV="development"
